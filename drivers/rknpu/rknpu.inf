;
; rknpu.inf - RK3576 NPU (RKNN, two cores)
;
; Device setup class: ComputeAccelerator, which Device Manager lists as
; "Neural processors" (the class MCDM NPU drivers such as Intel's use).
; Nothing in Windows treats a device differently for being in it; this
; driver is plain KMDF, not MCDM, and only the grouping and the name change.
; ClassInstall32 registers the class on a Windows that does not have it yet;
; Windows processes it only when the class key is missing, so where the
; class is already registered the system's own name and icon win.
;
; Target: Windows on ARM64. Binds ACPI\RKCP3576, which edk2-rk3576 publishes
; in an SSDT (OEM table ID RKNPU) only when "NPU (experimental)" is enabled
; in the firmware's ACPI / Device Tree setup page. The firmware powers and
; clocks the NPU; this driver maps its registers, connects its two
; interrupts and gives tools\rknputest access (\\.\RKNPU, administrators
; only). It runs an NPU job only when asked to through the M3 IOCTLs
; (rknputest m3); until then it does what the M2 driver did.
;
; rknpu.man, the performance counter manifest ("RK3576 NPU", "RK3576 NPU
; Memory"), is copied into the driver store beside rknpu.sys. An INF has no
; directive that registers a counter provider, so lodctr is run by
; tools\rknpu-perfcounters.ps1 after the driver is bound, and unlodctr by
; the same script with -Uninstall (docs/dev/perfcounters.md). Without that step
; the driver runs the same; the counters are just not visible.
;
; Copyright (c) 2026 Ga Hing Woo <gahing@gahingwoo.com>
; SPDX-License-Identifier: GPL-2.0-only
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = ComputeAccelerator
ClassGuid   = {F01A9D53-3FF6-48D2-9F97-C8A7004BE10C}
Provider    = %ProviderName%
DriverVer   = ; set by stampinf during build
CatalogFile = rknpu.cat
PnpLockdown = 1

[ClassInstall32]
AddReg = RKNPU_ClassReg

[RKNPU_ClassReg]
HKR,,,0,%ClassName%

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
rknpu.sys = 1
rknpu.man = 1

[Manufacturer]
%ProviderName% = Standard,NTARM64.10.0...16299

[Standard.NTARM64.10.0...16299]
%RKNPU.DeviceDesc% = RKNPU_Inst,ACPI\RKCP3576

[RKNPU_Inst.NT]
CopyFiles = RKNPU_CopyFiles

[RKNPU_CopyFiles]
rknpu.sys
rknpu.man

[RKNPU_Inst.NT.Services]
AddService = rknpu,0x00000002,RKNPU_Service

[RKNPU_Service]
DisplayName   = %RKNPU.SvcDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\rknpu.sys

[RKNPU_Inst.NT.Wdf]
KmdfService = rknpu, RKNPU_wdfsect

[RKNPU_wdfsect]
KmdfLibraryVersion = 1.33

[Strings]
ProviderName     = "woa-rk3576-npu"
DiskName         = "RK3576 NPU Installation Disk"
ClassName        = "Neural processors"
RKNPU.DeviceDesc = "Rockchip RK3576 NPU"
RKNPU.SvcDesc    = "Rockchip RK3576 NPU driver"
